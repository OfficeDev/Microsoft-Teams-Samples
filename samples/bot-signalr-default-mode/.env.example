# Copy to .env and fill in. (Only needed for the plain `npm run dev` path — the F5 Teams Toolkit flow
# auto-populates BOT_ID + .localConfigs for you; see README.)

# Local APX BotNotifications role base URL (where /v3/websockets/connect lives). 444 is the
# BotNotifications port in the standard local INT config (BotFrontEnd is 443).
APX_BASE_URL=https://localhost:444

# The bot's MSA AppId = the socket botKey (stamped as the hub connection's UserId). In a DEBUG local
# APX build, negotiate accepts ?botKey=<this> with no auth. The F5 flow sets BOT_ID instead (which
# takes precedence); set BOT_KEY here only for the manual `npm run dev` path.
BOT_KEY=

# Sockets kept open (APX's default per-bot limit is 3). Each is refreshed 60 s before its token expires
# with the x-ms-socket-replaces-connection-id header, and reconnected after a drop.
SOCKET_CONNECTIONS=3

# Startup self-test (limit probe, refresh scenarios, same-token checks). Set to false to skip it.
SOCKET_SELF_TEST=true

# Optional, for trying refreshes quickly: refresh each socket this many seconds after it is ready.
# SOCKET_REFRESH_AFTER_SECONDS=120

# Default invoke behavior if the invoke carries no payload.value.directive.
# One of: ok | error | delay | drop
DEFAULT_DIRECTIVE=ok

# Local APX uses a dev TLS cert; allow Node to trust it for the negotiate fetch.
NODE_TLS_REJECT_UNAUTHORIZED=0
