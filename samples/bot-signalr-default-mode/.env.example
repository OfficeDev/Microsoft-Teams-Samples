# Copy to .env and fill in. (Only needed for the plain `npm run dev` path — the F5 Teams Toolkit flow
# auto-populates BOT_ID + .localConfigs for you; see README.)

# Regions to connect in, one socket each (default: amer,emea,apac; eudb is also supported). Each region delivers only
# its own traffic. The bot connects at https://{region}.botapi.skype.com/{region}/v3/websockets/connect, so the
# socket lands on that region's SignalR resource. The connect host isn't configurable.
APX_REGIONS=amer,emea,apac

# The bot's MSA AppId = the socket botKey (stamped as the hub connection's UserId). The F5 flow sets
# BOT_ID instead (which takes precedence); set BOT_KEY here only for the manual `npm run dev` path.
BOT_KEY=

# Default invoke behavior if the invoke carries no payload.value.directive.
# One of: ok | error | delay | drop
DEFAULT_DIRECTIVE=ok

# TLS validation: 1 = validate (production); 0 = accept a self-signed local APX dev cert.
NODE_TLS_REJECT_UNAUTHORIZED=1
