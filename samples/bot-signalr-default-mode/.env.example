# Copy to .env and fill in. (Only needed for the plain `npm run dev` path — the F5 Teams Toolkit flow
# auto-populates BOT_ID + .localConfigs for you; see README.)

# APX host that serves the WebSocket connect API, without a region. The bot connects once per region at
# {APX_BASE_URL}/{region}/v3/websockets/connect. For a local DEBUG APX use https://localhost:444 with APX_REGIONS=amer.
APX_BASE_URL=https://botapi.skype.com

# Regions to connect in, one socket each (default: all of them). Each region delivers only its own traffic.
APX_REGIONS=amer,emea,apac

# With APX_BASE_URL=https://botapi.skype.com, connect goes to each region's own host (https://{region}.botapi.skype.com)
# so the socket lands on that region's SignalR resource. Set false to connect through APX_BASE_URL as is.
# APX_GEO_CONNECT_HOST=true

# The bot's MSA AppId = the socket botKey (stamped as the hub connection's UserId). In a DEBUG local
# APX build, negotiate accepts ?botKey=<this> with no auth. The F5 flow sets BOT_ID instead (which
# takes precedence); set BOT_KEY here only for the manual `npm run dev` path.
BOT_KEY=

# Default invoke behavior if the invoke carries no payload.value.directive.
# One of: ok | error | delay | drop
DEFAULT_DIRECTIVE=ok

# TLS validation: 1 = validate (production); 0 = accept a self-signed local APX dev cert.
NODE_TLS_REJECT_UNAUTHORIZED=1
