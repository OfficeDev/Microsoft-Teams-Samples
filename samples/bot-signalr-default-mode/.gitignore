.env.*.local
.localConfigs
.localConfigs.*
env/.env.*
!env/.env.*.sample

# Teams Toolkit generated output
appPackage/build/
devTools/

# Local Redis lockfile / pid (if ever placed in-repo)
*.pid

# OS / editor cruft
.DS_Store
Thumbs.db
