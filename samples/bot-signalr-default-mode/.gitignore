# Dependencies / build output
node_modules/
lib/
dist/
*.tsbuildinfo

# Run logs (logs/socket-test-*.log) and anything else dropped in logs/, e.g. exported service logs
logs/
*.log

# Secrets & local env -- NEVER commit (templates .env.example and env/*.sample ARE tracked)
.env
