# Committed template for env/.env.local. Copy to env/.env.local (gitignored).
TEAMSFX_ENV=local
APP_NAME_SUFFIX=local

# Generated during provision. Leave empty to create NEW registrations; set to reuse existing ones.
TEAMS_APP_ID=
BOT_ID=
AAD_APP_OBJECT_ID=
AAD_APP_TENANT_ID=

# Bot runtime settings.
# Default target is APX Canary (public BotFrontEnd gateway, amer region). For a local DEBUG APX use
# APX_BASE_URL=https://localhost:444 and set NODE_TLS_REJECT_UNAUTHORIZED=0 to accept the dev cert.
APX_BASE_URL=https://canary.botapi.skype.com/amer
DEFAULT_DIRECTIVE=ok
# Connect route selector. A socket connect is a bot-level operation with NO conversation, so APX
# never resolves a tenant for it — gate DeliverEventViaSocketEnabled / DeliverEventViaSocketBotAllowList
# by botId or globally, NOT by tenant. Keep false to use the plain route {cloud}/v3/websockets/connect.
# Set true only to force the tenantized route {cloud}/{tenantId}/v3/websockets/connect (single-tenant
# bots), which additionally requires the ring to have TenantIdInPathRoutesEnabled on (else connect 405s).
TENANT_IN_PATH=false
# TLS validation: 1 = validate (Canary, valid cert); 0 = accept a self-signed local APX dev cert.
# Must be non-empty — the M365 Agents Toolkit fails to resolve an empty ${{placeholder}}.
NODE_TLS_REJECT_UNAUTHORIZED=1
