# Rename this file to .env and fill in real values — never commit .env itself.

# Anthropic API key, used by src/llm.ts for chat replies and thread summaries.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Written automatically by `teams app create --env .env` when you register the
# bot (see README setup steps). Do not fill these in by hand ahead of time.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
